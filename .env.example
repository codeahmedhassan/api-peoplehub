NODE_ENV=production
PORT=3000

# Database (MongoDB Atlas / Production URI)
MONGODB_URI=your-mongodb-connection-uri

# JWT (generate 64+ char random secrets)
JWT_ACCESS_SECRET=your-jwt-access-secret
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_SUPER_ADMIN_ACCESS_SECRET=your-super-admin-access-secret
JWT_SUPER_ADMIN_REFRESH_SECRET=your-super-admin-refresh-secret

# CORS & Frontend URLs
MARKETING_URL=https://corpilance.tech
ADMIN_URL=https://admin.corpilance.tech
SUPER_ADMIN_URL=https://console.corpilance.tech
CORS_ALLOWED_ORIGINS=https://corpilance.tech,https://www.corpilance.tech,https://admin.corpilance.tech,https://console.corpilance.tech

# Cookies (.corpilance.tech shares auth session cookies across all subdomains)
COOKIE_DOMAIN=.corpilance.tech
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-email@example.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM="CorpiLance <no-reply@corpilance.tech>"
SUPPORT_EMAIL=corpilance.org@gmail.com

# Verification & Password Reset Tokens
EMAIL_VERIFY_EXPIRES_IN=24h
EMAIL_VERIFY_SECRET=your-email-verify-secret

# Envelope Encryption Key (KEK) — 32 bytes base64 encoded
DOCUMENT_KEK=your-32-byte-base64-document-kek

# AWS S3 (Block Public Access enabled)
# On AWS EC2 with an attached IAM Instance Role, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY unset.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
# Optional (only needed for local development outside EC2):
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
