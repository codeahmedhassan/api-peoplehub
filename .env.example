NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/hr_database

# JWT (use long random 64+ character hex/base64 secrets in production)
JWT_ACCESS_SECRET=replace-with-random-64-char-access-secret
JWT_REFRESH_SECRET=replace-with-random-64-char-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_SUPER_ADMIN_ACCESS_SECRET=replace-with-dedicated-super-admin-access-secret
JWT_SUPER_ADMIN_REFRESH_SECRET=replace-with-dedicated-super-admin-refresh-secret

# CORS & App URLs (set to your production HTTPS origins)
MARKETING_URL=https://corpilance.com
ADMIN_URL=https://admin.corpilance.com
SUPER_ADMIN_URL=https://superadmin.corpilance.com
CORS_ALLOWED_ORIGINS=https://corpilance.com,https://www.corpilance.com,https://admin.corpilance.com,https://superadmin.corpilance.com

# Cookies (use .corpilance.com and COOKIE_SECURE=true in production HTTPS)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password
EMAIL_FROM="CorpiLance <no-reply@corpilance.com>"
SUPPORT_EMAIL=corpilance.org@gmail.com

# Email & Reset Verification Tokens
EMAIL_VERIFY_EXPIRES_IN=24h
EMAIL_VERIFY_SECRET=replace-with-random-64-char-email-verify-secret

# Envelope Encryption Key (KEK) for encrypting document keys. Must be 32 bytes base64 encoded.
DOCUMENT_KEK=replace-with-32-byte-base64-encryption-key

# AWS S3 (bucket must have Block Public Access enabled; no public policy)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-private-s3-bucket
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key
